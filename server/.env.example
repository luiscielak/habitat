# Copy to `.env` and fill in. NEVER commit the real .env file.

# Required: your OpenAI secret key (server-side only, never shipped in the app).
OPENAI_API_KEY=sk-your-key-here

# Shared secret the iOS app must send as `Authorization: Bearer <token>`.
# Generate a long random string, e.g. `openssl rand -hex 32`.
# Leave empty to disable auth (local development only).
APP_SHARED_SECRET=

# Optional overrides (sensible defaults are used if omitted).
PORT=8080
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=300
OPENAI_TEMPERATURE=0.7
OPENAI_BASE_URL=https://api.openai.com/v1

# Rate limiting (per IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Payload guardrails.
MAX_SYSTEM_PROMPT_CHARS=20000
MAX_USER_MESSAGE_CHARS=8000
