// Secrets.example.xcconfig
//
// Copy this file to `Secrets.xcconfig` (git-ignored) and fill in your values.
//
//     cp Secrets.example.xcconfig Secrets.xcconfig
//
// IMPORTANT: xcconfig treats "//" as the start of a comment, so a URL like
// https://example.com would be truncated to "https:". Use the $(SLASH) helper
// (defined in Shared.xcconfig) to embed the literal slashes:
//
//     COACH_PROXY_URL = https:$(SLASH)$(SLASH)your-proxy-host.example.com
//
// Base URL of your deployed coach proxy (no trailing slash).
COACH_PROXY_URL = https:$(SLASH)$(SLASH)your-proxy-host.example.com

// Shared secret matching the proxy's APP_SHARED_SECRET. Leave blank if the
// proxy runs without auth (local dev only).
COACH_PROXY_TOKEN =
